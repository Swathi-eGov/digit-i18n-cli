# Base URL of the DIGIT backend/gateway (no trailing slash), e.g. https://unified-dev.digit.org
DIGIT_API_BASE_URL=

# Tenant id to query, e.g. mz or pg.citya
DIGIT_TENANT_ID=

# Optional: auth token, only needed if this environment's localization search
# is not publicly readable. Leave blank to send authToken: null.
DIGIT_AUTH_TOKEN=

# Optional: default locale used when --locale is not passed on the command line
DIGIT_DEFAULT_LOCALE=en_IN

# Optional: where local localizations/ JSON files are read/written
# (default: ./localizations relative to the current working directory)
DIGIT_LOCALIZATIONS_DIR=

# Optional: default target locale(s) for "apply --to" when --to isn't passed
# explicitly, e.g. hi_IN,fr_FR,pt_MZ. Not sensitive, just locale codes.
DIGIT_UPSERT_LOCALES=

# Used ONLY by "apply", to log in fresh (via POST /user/oauth/token) at the
# moment it runs — never cached, never reused across runs. This must be an
# employee account with localization-upsert access. SENSITIVE — make sure
# .env is in your project's .gitignore before filling these in.
DIGIT_USERNAME=
DIGIT_PASSWORD=
DIGIT_USER_TYPE=EMPLOYEE
